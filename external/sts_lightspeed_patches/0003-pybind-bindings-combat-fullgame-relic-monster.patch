 using namespace sts;
 
+// ============================================================================
+//  受控战斗探针绑定 (combat probe bindings)
+//  目标: 让 Python 能 "构造受控战斗 -> 打单卡 -> 读状态"
+//  设计: 在 C++ 侧封一个 make_test_combat helper, 把 init + 覆写手牌/敌人 hp/
+//        玩家 buff 全部封在一个函数里, 避免暴露太多裸字段。
+// ============================================================================
+namespace sts::probe {
+
+    // 构造一个受控战斗:
+    //   gc          : Python 侧构造好的 GameContext (提供 seed / map / relic 等基底)
+    //   encounter   : 选哪个遭遇 (如 MonsterEncounter.JAW_WORM / CULTIST)
+    //   player_hp   : 覆写玩家当前血量 (<=0 表示不覆写)
+    //   energy      : 覆写本回合能量 (<0 表示不覆写)
+    //   hand        : 手牌卡 id 列表 (按顺序塞进 hand[0..n))
+    //   enemy_hps   : 每个敌人的 curHp 覆写 (按 monster idx, 空/越界则不覆写)
+    //   strength    : 玩家力量 (覆写绝对值)
+    //   block       : 玩家护甲 (覆写绝对值)
+    //   relics      : 要装到玩家身上的遗物 id 列表。在 bc.init() 之前先 obtainRelic 到
+    //                 gc.relics, 这样 BattleContext::initRelics + executeActions 会真实
+    //                 触发 atBattleStart / atBattleStartPreDraw 效果 (这正是要验收的核心)。
+    BattleContext make_test_combat(
+            const GameContext &gc,
+            MonsterEncounter encounter,
+            int player_hp,
+            int energy,
+            const std::vector<CardId> &hand,
+            const std::vector<int> &enemy_hps,
+            int strength,
+            int block,
+            const std::vector<RelicId> &relics,
+            const std::vector<CardId> &draw_pile,
+            bool clear_draw_pile) {
+
+        // gc 是 const ref, 但装遗物需要改 gc.relics。复制一份本地 gc 再装遗物。
+        GameContext gcLocal = gc;
+        // player_hp 在 init 前写到 gcLocal: init 里 player.curHp = gc.curHp, 这样
+        // Blood Vial 这类开战回血会叠在设定血量之上 (而非被 init 后覆写清掉)。
+        if (player_hp > 0) {
+            gcLocal.curHp = player_hp;
+            if (player_hp > gcLocal.maxHp) {
+                gcLocal.maxHp = player_hp;
+            }
+        }
+        for (RelicId rid : relics) {
+            if (rid != RelicId::INVALID && !gcLocal.relics.has(rid)) {
+                gcLocal.obtainRelic(rid);
+            }
+        }
+
+        BattleContext bc;
+        bc.init(gcLocal, encounter);
+
+        // ---- 覆写玩家 ----
+        if (energy >= 0) {
+            bc.player.energy = energy;
+        }
+        // strength/block 用 INT_MIN 当 "不覆写" 哨兵: 这样遗物 (Vajra 力量 / Anchor 护甲)
+        // 在 init 里施加的效果不会被覆写清掉。显式传值 (含 0) 仍按绝对值覆写。
+        static const int NO_OVERRIDE = std::numeric_limits<int>::min();
+        if (strength != NO_OVERRIDE) {
+            bc.player.strength = strength;
+        }
+        if (block != NO_OVERRIDE) {
+            bc.player.block = block;
+        }
+
+        // ---- 覆写手牌 ----
+        // init 不发牌 (DrawCards 被注释掉), 这里手动塞牌进 hand。
+        int n = static_cast<int>(hand.size());
+        if (n > CardManager::MAX_HAND_SIZE) {
+            n = CardManager::MAX_HAND_SIZE;
+        }
+        for (int i = 0; i < n; ++i) {
+            CardInstance ci(hand[i], false);
+            ci.setUniqueId(bc.cards.nextUniqueCardId++);
+            bc.cards.hand[i] = ci;
+        }
+        bc.cards.cardsInHand = n;
+
+        // ---- 塞抽牌堆 (draw_pile) ----
+        // init 会按 master deck 把起始牌发进抽牌堆。clear_draw_pile=true 时先清空,
+        // 这样 draw_pile 参数能确定性控制抽堆内容 (验 Mind Blast 伤害=抽堆张数 /
+        // 牌堆内容断言)。底->顶按列表顺序 push, 末尾元素是堆顶 (popFromDrawPile 取末尾)。
+        if (clear_draw_pile) {
+            bc.cards.drawPile.clear();
+        }
+        for (CardId cid : draw_pile) {
+            if (cid == CardId::INVALID) {
+                continue;
+            }
+            CardInstance ci(cid, false);
+            ci.setUniqueId(bc.cards.nextUniqueCardId++);
+            bc.cards.drawPile.push_back(ci);
+        }
+
+        // ---- 重算派生计数 (strikeCount 等) ----
+        // init 已按它自己发的 drawPile 算过一次 strikeCount, 但我们覆写了手牌 +
+        // 重塞了抽牌堆, 故从实际 hand + drawPile + discardPile 重新数 Strike 牌,
+        // 否则 Perfected Strike (按 combat 内 Strike 数加伤) 会算错。
+        {
+            int strikeCount = 0;
+            for (int i = 0; i < bc.cards.cardsInHand; ++i) {
+                if (bc.cards.hand[i].isStrikeCard()) { ++strikeCount; }
+            }
+            for (const auto &ci : bc.cards.drawPile) {
+                if (ci.isStrikeCard()) { ++strikeCount; }
+            }
+            for (const auto &ci : bc.cards.discardPile) {
+                if (ci.isStrikeCard()) { ++strikeCount; }
+            }
+            bc.cards.strikeCount = strikeCount;
+        }
+
+        // ---- 覆写敌人 hp ----
+        int m = static_cast<int>(enemy_hps.size());
+        for (int i = 0; i < m && i < bc.monsters.monsterCount; ++i) {
+            if (enemy_hps[i] > 0) {
+                bc.monsters.arr[i].curHp = enemy_hps[i];
+                if (enemy_hps[i] > bc.monsters.arr[i].maxHp) {
+                    bc.monsters.arr[i].maxHp = enemy_hps[i];
+                }
+            }
+        }
+
+        return bc;
+    }
+
+    // 只构造战斗、不覆写敌人 hp / 不塞手牌 / 不覆写玩家 buff 的 helper:
+    //   要验收 "怪物按 seed 随机生成的真实 HP / 首回合意图 / pre-battle 开战机制",
+    //   必须让引擎自己 init 怪物 (setRandomHp / rollMove 首招 / preBattleAction 开战 buff)
+    //   而不被任何覆写污染。返回 init 完的 BattleContext, snapshot 里读到的就是引擎真值。
+    //     gc        : Python 侧构造好的 GameContext (seed / ascension 等基底)
+    //     encounter : 选哪个遭遇
+    //     player_hp : 覆写玩家当前血量 (<=0 表示不覆写, 不影响怪物验收)
+    //     energy    : 覆写本回合能量 (<0 表示不覆写)
+    //     relics    : 装到玩家身上的遗物 (init 前 obtain, 这样 atBattleStart 真触发)
+    BattleContext make_encounter(
+            const GameContext &gc,
+            MonsterEncounter encounter,
+            int player_hp,
+            int energy,
+            const std::vector<RelicId> &relics) {
+        GameContext gcLocal = gc;
+        if (player_hp > 0) {
+            gcLocal.curHp = player_hp;
+            if (player_hp > gcLocal.maxHp) {
+                gcLocal.maxHp = player_hp;
+            }
+        }
+        for (RelicId rid : relics) {
+            if (rid != RelicId::INVALID && !gcLocal.relics.has(rid)) {
+                gcLocal.obtainRelic(rid);
+            }
+        }
+        BattleContext bc;
+        bc.init(gcLocal, encounter);
+        if (energy >= 0) {
+            bc.player.energy = energy;
+        }
+        // 注意: 不动 enemy hp / hand / strength / block, 全部保留引擎按 seed 生成的真值。
+        return bc;
+    }
+
+    // 打出指定手牌索引的卡, target_index 指敌人 idx (非目标卡可填 0)。
+    // 先用 isValidAction 校验: 不合法 (如 Clash 手里有非攻击牌时不可打出) 直接返回
+    // false 不执行, 避免 execute 内部 assert/UB 崩溃。合法则打出返回 true。
+    bool play_card(BattleContext &bc, int hand_index, int target_index) {
+        search::Action action(search::ActionType::CARD, hand_index, target_index);
+        if (!action.isValidAction(bc)) {
+            return false;
+        }
+        action.execute(bc);
+        return true;
+    }
+
+    // 结束当前回合 (会触发敌人行动)
+    void end_turn(BattleContext &bc) {
+        search::Action(search::ActionType::END_TURN).execute(bc);
+    }
+
+    // 读取战斗快照, 中性 dict 结构:
+    //   { player: {...}, enemies: [ {...}, ... ], outcome: str, turn: int }
+    pybind11::dict get_combat_snapshot(const BattleContext &bc) {
+        namespace py = pybind11;
+        py::dict snap;
+
+        py::dict player;
+        player["hp"] = bc.player.curHp;
+        player["max_hp"] = bc.player.maxHp;
+        player["block"] = bc.player.block;
+        player["energy"] = bc.player.energy;
+        player["strength"] = bc.player.getStatus<PS::STRENGTH>();
+        player["dexterity"] = bc.player.getStatus<PS::DEXTERITY>();
+        player["artifact"] = bc.player.getStatus<PS::ARTIFACT>();
+        player["vulnerable"] = bc.player.getStatus<PS::VULNERABLE>();
+        player["weak"] = bc.player.getStatus<PS::WEAK>();
+        player["frail"] = bc.player.getStatus<PS::FRAIL>();
+        // ---- 遗物验收新增字段 ----
+        player["thorns"] = bc.player.getStatus<PS::THORNS>();
+        player["metallicize"] = bc.player.getStatus<PS::METALLICIZE>();
+        player["regen"] = bc.player.getStatus<PS::REGEN>();
+        player["ritual"] = bc.player.getStatus<PS::RITUAL>();
+        player["vigor"] = bc.player.getStatus<PS::VIGOR>();
+        // ---- 卡牌验收新增字段 (此前 snapshot 不暴露, 导致这些状态卡误判红灯) ----
+        player["no_draw"] = bc.player.getStatus<PS::NO_DRAW>();        // Battle Trance
+        player["no_block"] = bc.player.getStatus<PS::NO_BLOCK>();      // Panic Button
+        // BARRICADE 是 bit-only boolean power (不写 statusMap), getStatus 会 .at() 抛异常,
+        // 必须用 hasStatus 读 (0/1)。
+        player["barricade"] = bc.player.hasStatus<PS::BARRICADE>() ? 1 : 0;  // Barricade
+        player["strength"] = bc.player.getStatus<PS::STRENGTH>();
+        player["energy_per_turn"] = bc.player.energyPerTurn;          // Berserk (+1/turn)
+        snap["player"] = player;
+
+        py::list enemies;
+        for (int i = 0; i < bc.monsters.monsterCount; ++i) {
+            const auto &e = bc.monsters.arr[i];
+            py::dict ed;
+            ed["idx"] = i;
+            ed["name"] = e.getName();
+            ed["hp"] = e.curHp;
+            ed["max_hp"] = e.maxHp;
+            ed["block"] = e.block;
+            ed["alive"] = e.isAlive();
+            ed["strength"] = e.getStatus<MS::STRENGTH>();
+            ed["vulnerable"] = e.getStatus<MS::VULNERABLE>();
+            ed["weak"] = e.getStatus<MS::WEAK>();
+            ed["poison"] = e.getStatus<MS::POISON>();
+            ed["metallicize"] = e.getStatus<MS::METALLICIZE>();
+            ed["ritual"] = e.getStatus<MS::RITUAL>();
+            ed["artifact"] = e.getStatus<MS::ARTIFACT>();
+            // Dark Shackles: 临时 -X 力量, 引擎记为 SHACKLED 层数 (回合末还回去)
+            ed["shackled"] = e.getStatus<MS::SHACKLED>();
+            // GENERIC_STRENGTH_UP: 部分怪 (如 Orb Walker) 的开战力量是 "每回合开始 +X 力量"
+            // 的 power, 不是开战瞬间的 STRENGTH 叠层。导出供验收区分 "真没加力量" vs "力量是 power 形式"。
+            ed["strength_up"] = e.getStatus<MS::GENERIC_STRENGTH_UP>();
+            // ---- 怪物意图验收新增字段 ----
+            // 当前/本回合招式 = moveHistory[0] (setMove 最近写入的那个; isAttacking() 也读它)。
+            MMID move = e.moveHistory[0];
+            ed["move_id"] = static_cast<int>(move);
+            ed["intent"] = std::string(monsterMoveStrings[static_cast<int>(move)]);
+            bool isAttack = isMoveAttack(move);
+            ed["is_attack"] = isAttack;
+            if (isAttack) {
+                // getMoveBaseDamage 返回本招式的基础伤害 + 段数 (未含玩家侧 vuln 等)。
+                DamageInfo di = e.getMoveBaseDamage(bc);
+                ed["intent_damage"] = di.damage;
+                ed["intent_hits"] = di.attackCount;
+            } else {
+                // 非攻击意图: damage 标 -1 表示 "无攻击伤害", 段数 0。
+                ed["intent_damage"] = -1;
+                ed["intent_hits"] = 0;
+            }
+            enemies.append(ed);
+        }
+        snap["enemies"] = enemies;
+
+        // ---- 牌堆内容 (pile inspection) ----
+        // 每堆导出卡名 list + 大小, 供验 Anger(复制进弃堆) / Wild Strike(Wound 进抽堆) /
+        // Pommel Strike(抽牌) / Pummel(Exhaust) / deck_composition 等机制。
+        // hand 只读 cardsInHand 张; draw/discard/exhaust 读整 vector。
+        auto pileNames = [](const auto &begin, const auto &end) {
+            namespace py = pybind11;
+            py::list names;
+            for (auto it = begin; it != end; ++it) {
+                names.append(std::string(it->getName()));
+            }
+            return names;
+        };
+        py::list handNames;
+        for (int i = 0; i < bc.cards.cardsInHand && i < CardManager::MAX_HAND_SIZE; ++i) {
+            handNames.append(std::string(bc.cards.hand[i].getName()));
+        }
+        snap["hand"] = handNames;
+        snap["draw_pile"] = pileNames(bc.cards.drawPile.begin(), bc.cards.drawPile.end());
+        snap["discard_pile"] = pileNames(bc.cards.discardPile.begin(), bc.cards.discardPile.end());
+        snap["exhaust_pile"] = pileNames(bc.cards.exhaustPile.begin(), bc.cards.exhaustPile.end());
+        snap["hand_size"] = bc.cards.cardsInHand;
+        snap["draw_pile_size"] = static_cast<int>(bc.cards.drawPile.size());
+        snap["discard_pile_size"] = static_cast<int>(bc.cards.discardPile.size());
+        snap["exhaust_pile_size"] = static_cast<int>(bc.cards.exhaustPile.size());
+
+        snap["outcome"] = static_cast<int>(bc.outcome);
+        snap["turn"] = bc.turn;
+        snap["cards_in_hand"] = bc.cards.cardsInHand;
+        return snap;
+    }
+
+    // ========================================================================
+    //  整局导航 (whole-game navigation)
+    //  目标: 让 Python 在每个元决策点 "读 screen/state + 可选项 -> 选一个", 把战斗
+    //        当黑盒交给引擎 MCTS 解决, 一直推进到 outcome != UNDECIDED。
+    //  设计: 统一用引擎自带的 search::GameAction::getAllActionsInState(gc) 枚举当前
+    //        screen 的所有合法动作, a.execute(gc) 应用。战斗单开一个 play_battle()。
+    // ========================================================================
+
+    static const char* screenStateName(ScreenState s) {
+        switch (s) {
+            case ScreenState::INVALID: return "INVALID";
+            case ScreenState::EVENT_SCREEN: return "EVENT_SCREEN";
+            case ScreenState::REWARDS: return "REWARDS";
+            case ScreenState::BOSS_RELIC_REWARDS: return "BOSS_RELIC_REWARDS";
+            case ScreenState::CARD_SELECT: return "CARD_SELECT";
+            case ScreenState::MAP_SCREEN: return "MAP_SCREEN";
+            case ScreenState::TREASURE_ROOM: return "TREASURE_ROOM";
+            case ScreenState::REST_ROOM: return "REST_ROOM";
+            case ScreenState::SHOP_ROOM: return "SHOP_ROOM";
+            case ScreenState::BATTLE: return "BATTLE";
+            default: return "?";
+        }
+    }
+
+    static const char* roomName(Room r) {
+        switch (r) {
+            case Room::SHOP: return "SHOP";
+            case Room::REST: return "REST";
+            case Room::EVENT: return "EVENT";
+            case Room::ELITE: return "ELITE";
+            case Room::MONSTER: return "MONSTER";
+            case Room::TREASURE: return "TREASURE";
+            case Room::BOSS: return "BOSS";
+            case Room::BOSS_TREASURE: return "BOSS_TREASURE";
+            case Room::NONE: return "NONE";
+            default: return "INVALID";
+        }
+    }
+
+    // 给一个 GameAction 在当前 screen 下生成人类可读 label (用于诊断/Python 侧打印)
+    static std::string actionLabel(const GameContext &gc, const search::GameAction &a) {
+        using RAT = search::GameAction::RewardsActionType;
+        std::ostringstream os;
+        switch (gc.screenState) {
+            case ScreenState::MAP_SCREEN:
+                os << "MAP->node_x=" << a.getIdx1();
+                break;
+            case ScreenState::EVENT_SCREEN:
+                os << "EVENT_choice=" << a.getIdx1();
+                break;
+            case ScreenState::REWARDS: {
+                switch (a.getRewardsActionType()) {
+                    case RAT::CARD: {
+                        const auto &r = gc.info.rewardsContainer;
+                        int ri = a.getIdx1();
+                        int ci = a.getIdx2();
+                        if (ri < r.cardRewardCount && ci < r.cardRewards[ri].size()) {
+                            os << "REWARD_card=" << r.cardRewards[ri][ci].getName();
+                        } else {
+                            os << "REWARD_card[" << ri << "," << ci << "]";
+                        }
+                        break;
+                    }
+                    case RAT::GOLD: os << "REWARD_gold"; break;
+                    case RAT::RELIC: os << "REWARD_relic"; break;
+                    case RAT::POTION: os << "REWARD_potion"; break;
+                    case RAT::KEY: os << "REWARD_key"; break;
+                    case RAT::CARD_REMOVE: os << "REWARD_card_remove"; break;
+                    case RAT::SKIP: os << "REWARD_skip/done"; break;
+                    default: os << "REWARD_?"; break;
+                }
+                break;
+            }
+            case ScreenState::SHOP_ROOM: {
+                switch (a.getRewardsActionType()) {
+                    case RAT::CARD: {
+                        const auto &s = gc.info.shop;
+                        os << "SHOP_buy_card=" << s.cards[a.getIdx1()].getName()
+                           << "($" << s.cardPrice(a.getIdx1()) << ")";
+                        break;
+                    }
+                    case RAT::RELIC: os << "SHOP_buy_relic[" << a.getIdx1() << "]"; break;
+                    case RAT::POTION: os << "SHOP_buy_potion[" << a.getIdx1() << "]"; break;
+                    case RAT::CARD_REMOVE: os << "SHOP_card_remove"; break;
+                    case RAT::SKIP: os << "SHOP_leave"; break;
+                    default: os << "SHOP_?"; break;
+                }
+                break;
+            }
+            case ScreenState::REST_ROOM: {
+                static const char* rest[] = {"REST", "SMITH", "RECALL", "LIFT", "TOKE", "DIG", "SKIP"};
+                int i = a.getIdx1();
+                os << "CAMPFIRE_" << ((i >= 0 && i <= 6) ? rest[i] : "?");
+                break;
+            }
+            case ScreenState::TREASURE_ROOM:
+                os << (a.getIdx1() == 0 ? "TREASURE_open" : "TREASURE_skip");
+                break;
+            case ScreenState::BOSS_RELIC_REWARDS:
+                os << (a.getIdx1() == 3 ? "BOSS_RELIC_skip" : ("BOSS_RELIC_pick=" + std::to_string(a.getIdx1())));
+                break;
+            case ScreenState::CARD_SELECT: {
+                int i = a.getIdx1();
+                if (i < gc.info.toSelectCards.size()) {
+                    os << "CARD_SELECT=" << gc.info.toSelectCards[i].card.getName();
+                } else {
+                    os << "CARD_SELECT[" << i << "]";
+                }
+                break;
+            }
+            default:
+                os << "action_bits=" << a.bits;
+                break;
+        }
+        return os.str();
+    }
+
+    // 读当前整局状态 + 当前决策点的所有合法动作 (中性 dict)。
+    //   { outcome, screen, room, act, floor, hp, max_hp, gold, deck_size,
+    //     relics_size, map_x, map_y, in_battle, encounter, choices: [ {idx, label} ] }
+    // choices 的 idx 就是传给 step_choice 的索引 (0..len-1)。
+    pybind11::dict get_state(const GameContext &gc) {
+        namespace py = pybind11;
+        py::dict d;
+        d["outcome"] = static_cast<int>(gc.outcome);
+        d["screen"] = screenStateName(gc.screenState);
+        d["room"] = roomName(gc.curRoom);
+        d["act"] = gc.act;
+        d["floor"] = gc.floorNum;
+        d["hp"] = gc.curHp;
+        d["max_hp"] = gc.maxHp;
+        d["gold"] = gc.gold;
+        d["deck_size"] = gc.deck.size();
+        d["relics_size"] = static_cast<int>(gc.relics.relics.size());
+        d["map_x"] = gc.curMapNodeX;
+        d["map_y"] = gc.curMapNodeY;
+        d["in_battle"] = (gc.screenState == ScreenState::BATTLE);
+        d["encounter"] = static_cast<int>(gc.info.encounter);
+
+        py::list choices;
+        if (gc.outcome == GameOutcome::UNDECIDED && gc.screenState != ScreenState::BATTLE) {
+            auto actions = search::GameAction::getAllActionsInState(gc);
+            for (size_t i = 0; i < actions.size(); ++i) {
+                py::dict c;
+                c["idx"] = static_cast<int>(i);
+                c["label"] = actionLabel(gc, actions[i]);
+                choices.append(c);
+            }
+        }
+        d["choices"] = choices;
+        return d;
+    }
+
+    // 应用当前 screen 下第 choice_index 个合法动作 (来自 get_state 的 choices 索引)。
+    // 返回 true 表示成功; false 表示索引越界 / 当前不是可选动作的 screen。
+    bool step_choice(GameContext &gc, int choice_index) {
+        if (gc.outcome != GameOutcome::UNDECIDED) return false;
+        if (gc.screenState == ScreenState::BATTLE) return false;
+        auto actions = search::GameAction::getAllActionsInState(gc);
+        if (choice_index < 0 || choice_index >= static_cast<int>(actions.size())) {
+            return false;
+        }
+        actions[choice_index].execute(gc);
+        return true;
+    }
+
+    // ========================================================================
+    //  战斗内合法动作枚举 + 执行 (Stage 1: 模型主导战斗的命脉)
+    //  目标: 让 Python 在战斗每一步 "读当前 InputState 的合法动作 -> 选一个 -> 执行",
+    //        把战斗从黑盒 (play_battle MCTS) 拆成逐步可控的状态机, 供 RL 模型直接出牌。
+    //  设计: 复用引擎自带的合法性 / 枚举逻辑 (search::Action / BattleScumSearcher2), 只在
+    //        Python 侧暴露: input_state / get_battle_actions / execute_battle_action。
+    //  注意 (引擎事实, 见 InputState.h / BattleScumSearcher2::enumerateActionsForNode):
+    //        sts_lightspeed 战斗里实际会停下来等玩家的交互 InputState 只有两个 ——
+    //        PLAYER_NORMAL (出牌 / 喝/弃药 / 结束回合) 和 CARD_SELECT (按 cardSelectTask
+    //        细分: 弃牌 / 消耗 / 升级选牌 / Headbutt / Dual Wield / Gamble 多选 等)。
+    //        InputState.h 里其余 ~25 个枚举值 (SCRY / CHOOSE_DISCARD_CARDS / SHUFFLE_* /
+    //        CREATE_RANDOM_* 等) 在本引擎里**从不被 assign 为活动状态** (executeActions
+    //        内部瞬间消化掉), 故无需为它们单独枚举。所有"弃牌 / 消耗 / scry 式留弃"在本
+    //        引擎里都走 CARD_SELECT + cardSelectTask 这一条路。
+
+    static const char* inputStateName(InputState s) {
+        switch (s) {
+            case InputState::EXECUTING_ACTIONS:    return "EXECUTING_ACTIONS";
+            case InputState::PLAYER_NORMAL:        return "PLAYER_NORMAL";
+            case InputState::CARD_SELECT:          return "CARD_SELECT";
+            case InputState::SCRY:                 return "SCRY";
+            case InputState::CHOOSE_STANCE_ACTION: return "CHOOSE_STANCE_ACTION";
+            case InputState::CHOOSE_DISCARD_CARDS: return "CHOOSE_DISCARD_CARDS";
+            default:                               return "OTHER";
+        }
+    }
+
+    // 当前 BattleContext 的交互输入状态字符串 (供 Python 判断该枚举哪类动作 / 是否轮到玩家)
+    pybind11::str get_input_state(const BattleContext &bc) {
+        return pybind11::str(inputStateName(bc.inputState));
+    }
+
+    // 把一个 search::Action 在当前 bc 下转成中性 dict (含足够信息让 Python 区分 + 回传执行)。
+    //   通用字段: type / bits (原始 32bit 编码, 回传执行时优先用它无损还原) / label (人类可读)。
+    //   CARD:   source_idx (手牌 idx), target_idx (敌人 idx; 无目标牌为 -1), card_name。
+    //   POTION: source_idx (药水槽 idx), target_idx (敌人 idx; 弃药/无目标为 -1 或 >5)。
+    //   SINGLE_CARD_SELECT: select_idx (在对应牌堆的 idx) + card_select_task (任务名)。
+    //   MULTI_CARD_SELECT:  selected_idxs (位掩码展开) + card_select_task。
+    static pybind11::dict actionToDict(const BattleContext &bc, const search::Action &a) {
+        namespace py = pybind11;
+        py::dict d;
+        d["bits"] = a.bits;
+        switch (a.getActionType()) {
+            case search::ActionType::CARD: {
+                d["type"] = "CARD";
+                d["source_idx"] = a.getSourceIdx();
+                const auto &c = bc.cards.hand[a.getSourceIdx()];
+                d["target_idx"] = c.requiresTarget() ? a.getTargetIdx() : -1;
+                d["card_name"] = std::string(c.getName());
+                break;
+            }
+            case search::ActionType::POTION:
+                d["type"] = "POTION";
+                d["source_idx"] = a.getSourceIdx();
+                d["target_idx"] = a.getTargetIdx();
+                break;
+
+            case search::ActionType::SINGLE_CARD_SELECT:
+                d["type"] = "SINGLE_CARD_SELECT";
+                d["select_idx"] = a.getSelectIdx();
+                d["card_select_task"] =
+                    std::string(cardSelectTaskStrings[static_cast<int>(bc.cardSelectInfo.cardSelectTask)]);
+                break;
+
+            case search::ActionType::MULTI_CARD_SELECT: {
+                d["type"] = "MULTI_CARD_SELECT";
+                py::list idxs;
+                for (int x : a.getSelectedIdxs()) { idxs.append(x); }
+                d["selected_idxs"] = idxs;
+                d["card_select_task"] =
+                    std::string(cardSelectTaskStrings[static_cast<int>(bc.cardSelectInfo.cardSelectTask)]);
+                break;
+            }
+            case search::ActionType::END_TURN:
+                d["type"] = "END_TURN";
+                break;
+
+            default:
+                d["type"] = "UNKNOWN";
+                break;
+        }
+        std::ostringstream os;
+        a.printDesc(os, bc);
+        d["label"] = os.str();
+        return d;
+    }
+
+    // 枚举当前 BattleContext 在其当前 InputState 下的所有合法动作 (dict 列表)。
+    //   - PLAYER_NORMAL: 出牌 (含选目标) + 喝/弃药 + END_TURN
+    //   - CARD_SELECT  : 按 cardSelectTask 枚举可选牌 (SINGLE_CARD_SELECT, GAMBLE/EXHAUST_MANY
+    //                    为 MULTI_CARD_SELECT 占位)
+    //   - 其它 (EXECUTING_ACTIONS / 战斗已分胜负): 返回空列表 (不该轮到玩家决策)
+    // 直接复用引擎 BattleScumSearcher2::enumerateActionsForNode, 保证与 MCTS / isValidAction
+    // 完全一致, 不另写一套合法性判断。
+    pybind11::list get_battle_actions(const BattleContext &bc) {
+        namespace py = pybind11;
+        py::list out;
+        if (bc.outcome != Outcome::UNDECIDED) {
+            return out;
+        }
+        if (bc.inputState != InputState::PLAYER_NORMAL &&
+            bc.inputState != InputState::CARD_SELECT) {
+            return out;  // EXECUTING_ACTIONS 等瞬态: 不枚举
+        }
+        search::BattleScumSearcher2 searcher(bc);
+        search::BattleScumSearcher2::Node node;
+        searcher.enumerateActionsForNode(node, bc);
+        for (const auto &edge : node.edges) {
+            if (edge.action.isValidAction(bc)) {
+                out.append(actionToDict(bc, edge.action));
+            }
+        }
+        return out;
+    }
+
+    // 执行一个动作。action 是 get_battle_actions 返回的 dict (或任何含 'bits' 的 dict)。
+    // 优先用 'bits' 无损还原 search::Action; 无 bits 则按 type + idx 字段重建。
+    // 返回 true=执行成功; false=动作非法 / 当前不可执行 (不执行, 避免 assert/UB)。
+    bool execute_battle_action(BattleContext &bc, pybind11::dict action) {
+        search::Action a;
+        if (action.contains("bits")) {
+            a = search::Action(action["bits"].cast<std::uint32_t>());
+        } else {
+            std::string type = action.contains("type") ? action["type"].cast<std::string>() : "";
+            int src = action.contains("source_idx") ? action["source_idx"].cast<int>() : 0;
+            int tgt = action.contains("target_idx") ? action["target_idx"].cast<int>() : 0;
+            int sel = action.contains("select_idx") ? action["select_idx"].cast<int>() : 0;
+            if (type == "CARD") {
+                a = search::Action(search::ActionType::CARD, src, tgt < 0 ? 0 : tgt);
+            } else if (type == "POTION") {
+                a = search::Action(search::ActionType::POTION, src, tgt);
+            } else if (type == "SINGLE_CARD_SELECT") {
+                a = search::Action(search::ActionType::SINGLE_CARD_SELECT, sel);
+            } else if (type == "END_TURN") {
+                a = search::Action(search::ActionType::END_TURN);
+            } else {
+                return false;  // MULTI_CARD_SELECT 无 bits 时不支持手搓重建 (TODO)
+            }
+        }
+        if (!a.isValidAction(bc)) {
+            return false;
+        }
+        a.execute(bc);
+        return true;
+    }
+
+    // 把当前战斗当黑盒交给引擎 MCTS 打完, 结束后写回 gc 并 regainControl (回到地图/奖励)。
+    //   sim_count: 每回合 MCTS 模拟数 (越大越强越慢); boss_mult: boss 战的额外倍率。
+    // 调用前提: gc.screenState == BATTLE。打完后 gc 要么进入下一个 screen (胜),
+    //           要么 outcome = PLAYER_LOSS (死)。
+    void play_battle(GameContext &gc, int sim_count, double boss_mult) {
+        if (gc.screenState != ScreenState::BATTLE) {
+            return;
+        }
+        search::ScumSearchAgent2 agent;
+        agent.simulationCountBase = sim_count;
+        agent.bossSimulationMultiplier = boss_mult;
+        agent.printLogs = false;
+        agent.printActions = false;
+
+        BattleContext bc;
+        bc.init(gc);
+        agent.playoutBattle(bc);
+        bc.exitBattle(gc);
+    }
+
+}
